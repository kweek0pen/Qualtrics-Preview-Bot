# Copy this file to .env and fill in both values:  cp .env.example .env
# .env is git-ignored, so your key never ends up on GitHub.

# Your OpenAI API key (https://platform.openai.com/api-keys).
# Used by the bot to write the simulated participant's answers.
OPENAI_API_KEY=sk-...

# The survey's PREVIEW link. In the Qualtrics survey editor click "Preview",
# then copy the address of the tab that opens. Keep the quotes: the link has "&" in it.
QUALTRICS_PREVIEW_URL='https://yourschool.qualtrics.com/jfe/preview/previewId/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/SV_xxxxxxxxxxxxxxx?Q_CHL=preview&Q_SurveyVersionID=current'
